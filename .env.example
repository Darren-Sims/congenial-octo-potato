# Local development only - Deno Deploy's dashboard has its own place to set
# environment variables for the deployed project (see README.md).

# Long random secret used to view the dashboard and stats API.
# Generate one with: deno eval "console.log(crypto.randomUUID() + crypto.randomUUID())"
ADMIN_TOKEN=change-me-to-a-long-random-value

# Comma-separated list of domains allowed to send events / considered valid
# "sites". Leave empty only for local testing - never in production.
ALLOWED_ORIGINS=esthersimsstudio.co.uk

# Fallback site name used if a request's URL can't be parsed.
DEFAULT_SITE=esthersimsstudio.co.uk

# Optional: path to a local KV file for `deno task dev`. On Deno Deploy this
# is ignored - Deploy provisions a managed, durable KV database automatically.
KV_PATH=./local.kv
